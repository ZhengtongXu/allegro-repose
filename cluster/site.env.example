# Copy to cluster/site.env (git-ignored). Sourced by submit.sh and every chunk (job.sbatch).
# The values below are for Purdue Gilbreth, account shey; change them for another cluster.
# Every setting can be overridden from the environment of submit.sh, e.g.
#   STANDBY_CHUNK_MIN=4 bash cluster/submit.sh smoke --mode standby
# Slurm passes the submitting environment on to the job, so the override holds for every later
# chunk of that chain (a fresh submit.sh from a clean shell drops it).
export ACCOUNT=${ACCOUNT:-shey}
export MEM=${MEM:-64G}
export WANDB_PROJECT=${WANDB_PROJECT:-allegro-repose}

# --mode priority: the group's long-wall QOS. Slurm allows one partition per such job.
# Gilbreth/shey: 4 x A100-40GB (a100-40gb) or 8 x A30 (a30), QOS normal, up to 14 days.
export PRIORITY_PARTITION=${PRIORITY_PARTITION:-a100-40gb}
export PRIORITY_QOS=${PRIORITY_QOS:-normal}
export PRIORITY_CONSTRAINT=${PRIORITY_CONSTRAINT:-}       # optional node feature, e.g. nvlink
export PRIORITY_WALL=${PRIORITY_WALL:-3-00:00:00}
export PRIORITY_CPUS=${PRIORITY_CPUS:-8}
export PRIORITY_CHUNK_MIN=${PRIORITY_CHUNK_MIN:-}         # empty: run until the wall-limit signal

# --mode standby: idle GPUs anywhere on the cluster, 4 h wall, several partitions allowed.
export STANDBY_PARTITIONS=${STANDBY_PARTITIONS:-a30,a100-40gb,a100-80gb,h100}
export STANDBY_QOS=${STANDBY_QOS:-standby}
export STANDBY_WALL=${STANDBY_WALL:-04:00:00}
export STANDBY_CPUS=${STANDBY_CPUS:-6}
export STANDBY_CHUNK_MIN=${STANDBY_CHUNK_MIN:-225}        # train.py checkpoints and exits after this many minutes
